#!/data/data/com.termux/files/usr/bin/sh
# WiFi auto-join nudge — executed by the Termux:Tasker plugin from
# periodic Tasker Time profiles (default: every 15 min), once per
# managed network class.
#
# Android deprioritizes captive-portal networks in its selector
# ("no internet" verdicts + historical failures), and screen-off
# scan throttling delays retries — observed on-device as a 15-30
# minute gap between a network being visible and Android joining.
# This wrapper runs wifi_nudge, which explicitly asks Android to
# connect when a target SSID is visible but unassociated, and can
# promote the device off a fallback SSID onto a preferred one.
#
# Target/fallback SSIDs arrive as "$@" from the Tasker task's
# Arguments field (e.g. "--ssid cmvwifi --fallback xfinitywifi"),
# so each Time profile chooses its own network class and the user
# can toggle a class by disabling its profile in the Tasker UI.
#
# Writes lifecycle events to the same shared history log as
# mvwifi_portal (distinguished by the "nudge" stage tag).  History is
# bounded to the last 200 lines.
HIST=/data/data/com.termux/files/home/storage/shared/Tasker/mvwifi_history.log
PHANTOM="$(/system/bin/settings get global settings_enable_monitor_phantom_procs 2>/dev/null)"
echo "$(date '+%F %T') | termux | nudge start | phantom=$PHANTOM" >> "$HIST" 2>/dev/null

/system/bin/settings put global settings_enable_monitor_phantom_procs false 2>/dev/null || true

# python -m rather than the mvwifi-nudge entry point: the editable
# install exposes new modules on git pull without needing a reinstall
# (entry-point scripts only appear at install time).
/data/data/com.termux/files/usr/bin/termux-wake-lock
/data/data/com.termux/files/usr/bin/python -m mvwifi_auto.wifi_nudge --verbose --log-file /data/data/com.termux/files/home/storage/shared/mvwifi_nudge.log "$@"
STATUS=$?
/data/data/com.termux/files/usr/bin/termux-wake-unlock

echo "$(date '+%F %T') | termux | nudge exit=$STATUS" >> "$HIST" 2>/dev/null
# Rotate under an atomic mkdir lock: concurrent wrappers (both nudge
# tasks fire in the same second) previously raced on a shared
# $HIST.tmp — a second `>` could truncate it before the first mv,
# leaving an empty history log.  Losers skip; the next run rotates.
LOCK="$HIST.lock"
if mkdir "$LOCK" 2>/dev/null; then
    tail -n 200 "$HIST" > "$HIST.tmp.$$" 2>/dev/null \
        && mv "$HIST.tmp.$$" "$HIST"
    rmdir "$LOCK"
fi
exit $STATUS
