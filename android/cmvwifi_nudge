#!/data/data/com.termux/files/usr/bin/sh
# Compatibility shim — the wrapper was renamed to wifi_nudge when it
# became multi-network.  Stale Tasker tasks (e.g. a project left over
# after a re-import) may still call this name; forward to wifi_nudge
# so they degrade to the default cmvwifi nudge instead of failing.
# Tag the history log so shim invocations are distinguishable from
# direct wifi_nudge calls — proves whether a stale task is live.
HIST=/data/data/com.termux/files/home/storage/shared/Tasker/mvwifi_history.log
echo "$(date '+%F %T') | termux | nudge via shim (stale tasker task)" >> "$HIST" 2>/dev/null
exec /data/data/com.termux/files/home/.termux/tasker/wifi_nudge "$@"
